# ==============================================================
#  Principal · 环境变量模板
#  用法：复制本文件为 .env（.env 已被 .gitignore 忽略，不会入库），
#        填入真实值后，用 `node --env-file=.env <入口>` 启动。
#  代码里所有 env 的唯一读取入口是 src/shared/config.js。
# ==============================================================

# ---------- 飞书（必填，飞书 bot 入口需要）----------
# 飞书开放平台「凭证与基础信息」页获取
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# owner 白名单：你自己的 open_id（完整能力，可任意读写/执行）
# 首次留空启动，给 bot 发一条消息，终端会打印 sender_open_id，复制填这里再重启
# 多个用逗号分隔
OWNER_OPEN_IDS=

# 「待处理/待办」triage 流程的专属白名单 open_id（单人）
# 注意：不要为此把自己填进 OWNER_OPEN_IDS——owner 的所有消息会被 claude-exec 全接，
# 需求/故障提交（feedback）流程就失效了；填这里即可用 guest 身份触发待办处理。
# 留空 = 沿用 OWNER_OPEN_IDS。
TRIAGE_OWNER_OPEN_ID=

# ⚠️ TRUSTED_OPEN_IDS 已废弃，当前版本【不生效】，填了也不会有任何效果与日志。
# 可信提交人现在只有一个来源：web 设置页「我的飞书身份 → 我的飞书 open_id」（单人）+ OWNER_OPEN_IDS 里的 owner。
# 保留本行只是为了让照旧配置的人一眼看到「这个开关已经没人读了」，不要再照抄。
# TRUSTED_OPEN_IDS=

# ---------- Web 服务（可选，均有默认值）----------
# 监听端口，默认 3000；服务固定绑定 127.0.0.1，勿改公网
PORT=3000

# ---------- 动作脚本执行（可选）----------
# 动作脚本所在目录，默认 scripts/（该目录已被 .gitignore 忽略，需自行放置脚本）
SCRIPTS_DIR=scripts
# Python 解释器，默认 python
PYTHON_BIN=python

# ---------- 模型（可选）----------
# 意图识别 / triage 兜底用的轻模型，默认 claude-sonnet-4-6
CLASSIFY_MODEL=claude-sonnet-4-6

# ---------- 需求/故障分析读取的代码目录（可选，仅只读分析）----------
# （已改为空串默认值：不配置就不指定工作目录，不会再静默指向别人机器上的路径）
FRONTEND_DIR=C:\path\to\your\frontend
BACKEND_DIR=C:\path\to\your\backend

# ---------- 埋点统计（tracking-stats 插件）----------
# 生产埋点库（只读账号）。密码必须走环境变量，不要写进源码。
TRACKING_DB_HOST=dongying-prod-public.rwlb.rds.aliyuncs.com
TRACKING_DB_PORT=3306
TRACKING_DB_NAME=compass_prod
TRACKING_DB_USER=compass_viewer
TRACKING_DB_PASSWORD=
# 前端仓库路径（可选）。自由形数据问答「帮我查数据:」会在此**受限只读检索**，
# 用来查证埋点的实际作用与属性取值含义 —— 库里的 event_mapping 只有中文名，
# 属性语义只写在前端 docs/*-events-for-ops.md 与调用点里。
# 只搜源码与文档；.env* / *.key / *.pem / node_modules / .git 一律屏蔽，路径不得越界。
# 不配置则该能力自动缺席，其余分析照常。
TRACKING_FRONTEND_DIR=

# compass-agent 仓库路径，仅埋点索引同步脚本使用：
#   node scripts/sync-event-dict.mjs
COMPASS_AGENT_DIR=

# ---------- 其它可选覆盖项 ----------
# triage 触发词正则（不填用内置默认：待处理|待办|代办|要处理|要办|处理一下）
# TRIAGE_TRIGGER=
# 处理中随机表情（emoji_type，逗号分隔），默认 OneSecond,OnIt,Typing,BETRAYED,SWEAT
# REACTION_EMOJIS=OneSecond,OnIt,Typing,BETRAYED,SWEAT
# 历史记录归属的项目 ID（默认按当前目录名推导）
# CLAUDE_PROJECT_ID=
