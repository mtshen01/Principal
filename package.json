{
  "name": "principal-desktop",
  "version": "1.0.0",
  "description": "Principal —— 让任何终端成为你的员工，你只做审计。",
  "main": "server.js",
  "scripts": {
    "test": "node --test \"src/**/*.test.js\" \"public/**/*.test.js\" \"benchmarks/**/*.test.js\"",
    "lint": "oxlint src public/js scripts tests benchmarks web.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "node server.js",
    "chat:console": "node src/entrypoints/console/index.js",
    "replay:run": "node scripts/replay-run.mjs",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "check:vendor": "node scripts/sync-vendor.mjs --check",
    "setup:superpowers": "node scripts/superpowers-fetch.mjs",
    "postinstall": "node scripts/superpowers-fetch.mjs --if-missing",
    "tauri": "tauri",
    "tauri:dev": "node scripts/prepare-sidecar.mjs --node-only && tauri dev",
    "tauri:build": "node scripts/sync-vendor.mjs --check && tauri build",
    "tauri:build:win": "node scripts/sync-vendor.mjs --check && node scripts/prepare-sidecar.mjs && tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac": "node scripts/sync-vendor.mjs --check && tauri build --target universal-apple-darwin",
    "build:release:win": "bash scripts/build-win.sh",
    "build:release:mac": "bash scripts/build-mac.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.16",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "ai": "^7.0.35",
    "animejs": "^4.5.0",
    "cobe": "^2.0.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "jsonrepair": "^3.15.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.11",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "playwright": "^1.61.1",
    "puppeteer": "^25.3.0"
  }
}
